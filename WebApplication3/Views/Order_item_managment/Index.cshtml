@model List<WebApplication3.Models.OrderItem>

<h1>Order Items</h1>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Dish</th>
            <th>Details</th>
            <th>Price</th>
            <th>VAT</th>
            <th>Stock</th>
            <th>Type</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Item_id</td>
                <td>@item.Dish_name</td>
                <td>@item.Details</td>
                <td>@item.Price</td>
                <td>@item.VAT</td>
                <td>@item.Stock</td>
                <td>@item.Type</td>
            </tr>
        }
    </tbody>
</table>