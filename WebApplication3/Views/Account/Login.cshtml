@model WebApplication3.Models.LoginModel

<h2>Login</h2>

@if (ViewBag.Error != null)
{
    <p style="color:red">
        @ViewBag.Error
    </p>
}

<form asp-action="Login" method="post">

    <div>
        <label>Username</label>

        <input asp-for="Username" />
    </div>

    <div>
        <label>Password</label>

        <input asp-for="Password" type="password" />
    </div>

    <br />

    <button type="submit">
        Login
    </button>

</form>