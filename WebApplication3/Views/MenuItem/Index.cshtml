@model List<WebApplication3.Models.OrderItem>

@{
    ViewData["Title"] = "Menu Items";
}

<h1>Menu Items</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Description</th>
            <th>Price</th>
            <th>VAT Category</th>
            <th>Course Type</th>
            <th>Quantity</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MenuItemID</td>

                <td>@item.Description</td>

                <td>€@item.Price</td>

                <td>
                    @(item.VatCategory ? "High" : "Low")
                </td>

                <td>@item.CourseType</td>

                <td>@item.Quantity</td>
            </tr>
        }
    </tbody>
</table>