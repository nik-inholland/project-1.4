@model List<WebApplication3.Models.ViewModels.TableViewModel>
@using WebApplication3.Models
@{
    ViewData["Title"] = "Restaurant Tables";
}

<h2>Restaurant Tables</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-grid">
    @foreach (var table in Model)
    {
        string imagePath = table.Occupied == TableStatus.Free
        ? "/images/table-free.png"
        : "/images/table-occupied.png";

        <div class="table-card">
            <img src="@imagePath" alt="Table" />
            <div class="table-text">
                <h3>Table @table.TableID</h3>
                <p>Status: <strong>@table.Occupied</strong></p>

                <!-- Take Order button -->
                <a asp-controller="Order" asp-action="TakeOrder"
                   asp-route-tableNumber="@table.TableID"
                   class="btn btn-sm @(table.Occupied == TableStatus.Free ? "btn-primary" : "btn-warning") w-100 mb-2">
                    @(table.Occupied == TableStatus.Free ? "📝 Take Order" : "➕ Add Order")
                </a>

                <!-- Toggle status button -->
                <form asp-action="ToggleStatus" asp-route-id="@table.TableID" method="post">
                    <button type="submit" class="btn btn-sm w-100 @(table.Occupied == TableStatus.Free ? "btn-outline-danger" : "btn-outline-success")"
                            onclick="return confirm('Change status of Table @table.TableID?')">
                        @(table.Occupied == TableStatus.Free ? "🔴 Mark Occupied" : "✅ Mark Free")
                    </button>
                </form>
            </div>
        </div>
    }
</div>

<style>
    .table-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
        margin-top: 20px;
    }

    .table-card {
        width: 220px;
        border: 2px solid #ccc;
        border-radius: 12px;
        overflow: hidden;
        background: white;
        transition: 0.2s ease;
        text-align: center;
    }

        .table-card:hover {
            transform: scale(1.03);
            border-color: #666;
        }

        .table-card img {
            width: 100%;
            height: 150px;
            object-fit: cover;
        }

    .table-text {
        padding: 10px;
        text-align: center;
    }
</style>