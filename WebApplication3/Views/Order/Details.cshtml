@model WebApplication3.Models.ViewModels.OrderDetailViewModel
@using WebApplication3.Models

<h2>Order – Table @Model.TableNumber</h2>

<p><strong>Status:</strong> @Model.Status</p>
<p><strong>Created:</strong> @Model.CreatedAt.ToString("HH:mm")</p>
<p><strong>Total:</strong> €@Model.TotalPrice.ToString("F2")</p>

<hr />

<h4>Change Order Status</h4>
@if (!Model.IsClosed && (Model.Status == OrderStatus.ReadyToBeServed || Model.Status == OrderStatus.Served))
{
    string toggleLabel = Model.Status == OrderStatus.ReadyToBeServed ? "Mark as Served" : "Mark as Ready";
    <form asp-action="ToggleOrderStatus" method="post">
        <input type="hidden" name="tableOrderID" value="@Model.TableOrderID" />
        <button type="submit" class="btn btn-sm btn-primary">@toggleLabel</button>
    </form>
}
else
{
    <p><em>Status cannot be toggled (only ReadyToBeServed/Served are toggleable).</em></p>
}

<hr />

@if (!Model.IsClosed)
{
    <form asp-action="CloseOrder" method="post">
        <input type="hidden" name="id" value="@Model.TableOrderID" />
        <button type="submit" class="btn btn-sm btn-danger">Close Order</button>
    </form>
}
else
{
    <p><strong>Order closed at:</strong> @Model.ClosedAt?.ToString("HH:mm")</p>
    <form asp-action="ReopenOrder" method="post">
        <input type="hidden" name="id" value="@Model.TableOrderID" />
        <button type="submit" class="btn btn-sm btn-secondary">Reopen Order</button>
    </form>
}

<hr />

<h4>Order Items</h4>

@if (Model.Items.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Item</th>
                <th>Qty</th>
                <th>Price</th>
                <th>Category</th>
                <th>Comments</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Quantity</td>
                    <td>€@item.Price.ToString("F2")</td>
                    <td>@item.Category</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Comments))
                        {
                            <small>@item.Comments</small>
                        }
                    </td>
                    <td>@item.ItemStatus</td>
                    <td>
                        @if (!Model.IsClosed && (item.ItemStatus == OrderStatus.ReadyToBeServed || item.ItemStatus == OrderStatus.Served))
                        {
                            string toggleLabel = item.ItemStatus == OrderStatus.ReadyToBeServed ? "Mark as Served" : "Mark as Ready";
                            <form asp-action="ToggleItemStatus" method="post" style="display:inline;">
                                <input type="hidden" name="orderId" value="@Model.TableOrderID" />
                                <input type="hidden" name="orderItemId" value="@item.OrderItemID" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">@toggleLabel</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No items in this order.</p>
}