@model List<WebApplication3.Models.ViewModels.OrderListViewModel>

<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />

@using WebApplication3.Models

<h2>Restaurant Orders</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Index" method="get" class="mb-3">
    <div class="row align-items-end">
        <div class="col-auto">
            <label for="count" class="form-label">Show orders:</label>
            <input type="number" id="count" name="count"
                   class="form-control" style="width:100px;"
                   min="1" max="500" value="@(ViewBag.Count ?? 10)" />
        </div>
        <div class="col-auto">
            <label for="dateFilter" class="form-label">Filter by date:</label>
            <input type="date" id="dateFilter" name="dateFilter"
                   class="form-control"
                   value="@ViewBag.DateFilter" />
        </div>
        <div class="col-auto">
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox"
                       name="showClosed" value="true"
                       @(ViewBag.ShowClosed is true ? "checked" : "") />
                <label class="form-check-label">Show closed orders</label>
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">Apply</button>
            <a asp-action="Index" class="btn btn-outline-danger">Clear</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No orders found.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span>Showing <strong>@Model.Count</strong> order(s)</span>
        <span>Total: <strong>@(Model.Count(o => !o.IsClosed))</strong> active, <strong>@(Model.Count(o => o.IsClosed))</strong> closed</span>
    </div>

    <div class="order-grid">
        @foreach (var order in Model.OrderBy(o => o.TableNumber))
        {
            string statusClass = order.Status switch
            {
                OrderStatus.Ordered => "ordered",
                OrderStatus.BeingPrepared => "preparing",
                OrderStatus.ReadyToBeServed => "ready",
                OrderStatus.Served => "served",
                OrderStatus.Cancelled => "cancelled",
                _ => ""
            };

            <div class="order-card @statusClass @(order.IsClosed ? "closed" : "")">
                <a asp-action="Details" asp-route-id="@order.TableOrderID" class="order-link">
                    <div class="order-text">
                        <h3>Table @order.TableNumber</h3>
                        <p>Status: <strong>@order.Status</strong></p>
                        <p>Date: @order.CreatedAt.ToString("dd/MM")</p>
                        <p>Time: @order.CreatedAt.ToString("HH:mm")</p>
                        <p>People: @order.PersonCount</p>
                        @if (order.IsClosed)
                        {
                            <span class="badge bg-secondary">Closed</span>
                        }
                    </div>
                </a>
                @if (order.IsClosed)
                {
                    <form asp-action="ReopenOrder" method="post" class="reopen-form">
                        <input type="hidden" name="id" value="@order.TableOrderID" />
                        <button type="submit" class="btn btn-sm btn-warning reopen-btn">↻ Reopen</button>
                    </form>
                }
            </div>
        }
    </div>
}